      "id": "l1",
      "speakerRole": 0,
      "addressRole": 1,
      "segments": [
        {
          "type": "text",
          "value": "Слушай, тут пахнет "
        },
        {
          "type": "blank",
          "blankId": "b1"
        },
        {
          "type": "text",
          "value": ". Ты тоже слышишь "
        },
        {
          "type": "blank",
          "blankId": "b2"
        },
        {
          "type": "text",
          "value": "?"
        }
      ]
    },
    {
      "id": "l2",
      "speakerRole": 1,
      "addressRole": 0,
      "segments": [
        {
          "type": "text",
          "value": "Да. И ещё вижу "
        },
        {
          "type": "blank",
          "blankId": "b3"
        },
        {
          "type": "text",
          "value": ". Давай не будем "
        },
        {
          "type": "blank",
          "blankId": "b4"
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "id": "l3",
      "speakerRole": 2,
      "addressRole": 0,
      "segments": [
        {
          "type": "text",
          "value": "Стойте. Я нашёл "
        },
        {
          "type": "blank",
          "blankId": "b5"
        },
        {
          "type": "text",
          "value": ". На бирке написано «"
        },
        {
          "type": "blank",
          "blankId": "b6"
        },
        {
          "type": "text",
          "value": "»."
        }
      ]
    },
    {
      "id": "l4",
      "speakerRole": 3,
      "addressRole": 2,
      "segments": [
        {
          "type": "text",
          "value": "Отлично. Теперь всем раздаём "
        },
        {
          "type": "blank",
          "blankId": "b7"
        },
        {
          "type": "text",
          "value": " и шепчем "
        },
        {
          "type": "blank",
          "blankId": "b8"
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "id": "l5",
      "speakerRole": 0,
      "addressRole": 1,
      "segments": [
        {
          "type": "text",
          "value": "План такой: берём "
        },
        {
          "type": "blank",
          "blankId": "b9"
        },
        {
          "type": "text",
          "value": ", идём к "
        },
        {
          "type": "blank",
          "blankId": "b10"
        },
        {
          "type": "text",
          "value": " и "
        },
        {
          "type": "blank",
          "blankId": "b11"
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "id": "l6",
      "speakerRole": 1,
      "addressRole": 0,
      "segments": [
        {
          "type": "text",
          "value": "Только без "
        },
        {
          "type": "blank",
          "blankId": "b12"
        },
        {
          "type": "text",
          "value": ". В прошлый раз всё кончилось "
        },
        {
          "type": "blank",
          "blankId": "b13"
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "id": "l7",
      "speakerRole": 0,
      "segments": [
        {
          "type": "text",
          "value": "Итог: если появится "
        },
        {
          "type": "blank",
          "blankId": "b14"
        },
        {
          "type": "text",
          "value": " — кричите «"
        },
        {
          "type": "text",
          "value": "» и держите "
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "id": "l8",
      "speakerRole": 1,
      "addressRole": 0,
      "segments": [
        {
          "type": "text",
          "value": "Договорились. За "
        },
        {
          "type": "text",
          "value": " и за то, что мы ещё "
        },
        {
          "type": "text",
          "value": "!"
        }
      ]
    },
    {
      "id": "l9",
      "speakerRole": 2,
      "segments": [
        {
          "type": "text",
          "value": "Я всё записываю в "
        },
        {
          "type": "text",
          "value": ". Заголовок: «"
        },
        {
          "type": "text",
          "value": "»."
        }
